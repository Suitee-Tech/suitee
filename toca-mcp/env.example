PORT=8090
GATEWAY_URL=http://localhost:8080

# Obrigatório: a superfície MCP (/mcp/sse, /mcp/messages) só aceita bearer
# verificado contra o JWKS do Supabase. Sem esta variável (ou SUPABASE_URL, de
# onde a URL do JWKS é derivada) toda requisição MCP é negada com 401.
SUPABASE_JWKS_URL=https://<projeto>.supabase.co/auth/v1/.well-known/jwks.json

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
