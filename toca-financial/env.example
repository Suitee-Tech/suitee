APP_ENV=development
APP_MODE=debug
PORT=8083

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_financial

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json

RABBITMQ_URI=amqp://toca_mq_user:change-me@rabbitmq:5672/
INTERNAL_API_KEY=

# SaaS subscriptions (independent of real-estate charges)
PLATFORM_SUBSCRIPTIONS_ENABLED=false
PAYMENT_GATEWAY_API_KEY=
ABACATEPAY_DEV_MODE=true
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_ALLOWED_IPS=
PUBLIC_FRONTEND_URL=https://app.example.com
