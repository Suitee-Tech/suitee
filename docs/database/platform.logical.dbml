// VISAO LOGICA: projecoes JSONB nao sao colunas SQL nem novas FKs.
Project suitee_logical {
  database_type: 'PostgreSQL'
  Note: 'Visao conceitual parcial dos vinculos comprovados no codigo. Campos json__ sao projecoes, nao colunas. Identificadores normalizados como text apenas neste diagrama. Nao exportar como migration.'
}

