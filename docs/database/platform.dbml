  Note: 'Origem: supabase/migrations/20260820234459_create_financial_managed_bills.sql\nRLS habilitado: true\nIndice SQL: CREATE INDEX idx_finance_managed_bills_active_reservations ON financial.managed_bills USING btree (tenant_id, source_transfer_id) WHERE (status = ANY (ARRAY[\'RESERVED\'::text, \'APPROVED\'::text]))\nCHECK ck_managed_bill_actor_timestamps: CHECK ((((approved_at IS NULL) OR (NULLIF(btrim(approved_by), \'\'::text) IS NOT NULL)) AND ((paid_at IS NULL) OR (NULLIF(btrim(paid_by), \'\'::text) IS NOT NULL)) AND ((reconciled_at IS NULL) OR (NULLIF(btrim(reconciled_by), \'\'::text) IS NOT NULL)) AND ((cancelled_at IS NULL) OR (NULLIF(btrim(cancelled_by), \'\'::text) IS NOT NULL))))\nCHECK ck_managed_bill_payment_attempts_array: CHECK ((jsonb_typeof(payment_attempts) = \'array\'::text))\nCHECK ck_managed_bill_status_milestones: CHECK ((((status <> ALL (ARRAY[\'APPROVED\'::text, \'PAID\'::text, \'RECONCILED\'::text])) OR (approved_at IS NOT NULL)) AND ((status <> ALL (ARRAY[\'PAID\'::text, \'RECONCILED\'::text])) OR (paid_at IS NOT NULL)) AND ((status <> \'RECONCILED\'::text) OR (reconciled_at IS NOT NULL)) AND ((status <> ALL (ARRAY[\'PAID\'::text, \'RECONCILED\'::text])) OR (NULLIF(btrim(payment_reference), \'\'::text) IS NOT NULL)) AND ((status <> ALL (ARRAY[\'PAID\'::text, \'RECONCILED\'::text])) OR (NULLIF(btrim(payment_journal_source_id), \'\'::text) IS NOT NULL)) AND ((status <> \'RECONCILED\'::text) OR (NULLIF(btrim(reconciliation_reference), \'\'::text) IS NOT NULL)) AND ((status <> \'CANCELLED\'::text) OR ((cancelled_at IS NOT NULL) AND (NULLIF(btrim(cancel_reason), \'\'::text) IS NOT NULL)))))\nCHECK ck_managed_bill_timestamp_order: CHECK (((updated_at >= created_at) AND (reserved_at >= created_at) AND ((approved_at IS NULL) OR (approved_at >= reserved_at)) AND ((paid_at IS NULL) OR (paid_at >= COALESCE(approved_at, reserved_at))) AND ((reconciled_at IS NULL) OR (reconciled_at >= paid_at)) AND ((cancelled_at IS NULL) OR (cancelled_at >= reserved_at))))\nCHECK managed_bills_amount_cents_check: CHECK ((amount_cents > 0))\nCHECK managed_bills_competence_month_check: CHECK ((competence_month ~ \'^[0-9]{4}-(0[1-9]|1[0-2])$\'::text))\nCHECK managed_bills_component_check: CHECK ((btrim(component) <> \'\'::text))\nCHECK managed_bills_contract_id_check: CHECK ((btrim(contract_id) <> \'\'::text))\nCHECK managed_bills_creditor_check: CHECK ((btrim(creditor) <> \'\'::text))\nCHECK managed_bills_currency_check: CHECK ((currency = \'BRL\'::text))\nCHECK managed_bills_description_check: CHECK ((btrim(description) <> \'\'::text))\nCHECK managed_bills_evidence_check: CHECK ((jsonb_typeof(evidence) = \'array\'::text))\nCHECK managed_bills_history_check: CHECK ((jsonb_typeof(history) = \'array\'::text))\nCHECK managed_bills_owner_id_check: CHECK ((btrim(owner_id) <> \'\'::text))\nCHECK managed_bills_property_id_check: CHECK ((btrim(property_id) <> \'\'::text))\nCHECK managed_bills_reserved_by_check: CHECK ((btrim(reserved_by) <> \'\'::text))\nCHECK managed_bills_source_key_check: CHECK ((btrim(source_key) <> \'\'::text))\nCHECK managed_bills_status_check: CHECK ((status = ANY (ARRAY[\'RESERVED\'::text, \'APPROVED\'::text, \'PAID\'::text, \'RECONCILED\'::text, \'CANCELLED\'::text])))\nCHECK managed_bills_version_check: CHECK ((version > 0))'
}

