Table audit.events [headercolor: #57534E] {
  "id" uuid [not null, default: `gen_random_uuid()`]
  "tenant_id" uuid [note: 'Tenant dono do evento. NULL para eventos de sistema sem contexto de tenant (ex. auth.login_success/register_success), que ocorrem antes da seleção de tenant.']
  "actor_id" uuid
  "actor_type" text [not null, default: `'user'::text`]
  "action" text [not null]
  "entity_type" text [not null]
  "entity_id" text [not null]
  "before" jsonb
  "after" jsonb
  "metadata" jsonb
  "created_at" "timestamp with time zone" [not null, default: `now()`]
  indexes {
    ("id", "created_at") [name: 'events_pkey', pk, type: btree]
    ("entity_type", "entity_id", "created_at") [name: 'idx_audit_events_entity', type: btree]
    ("tenant_id", "created_at") [name: 'idx_audit_events_tenant_created', type: btree]
  }
  Note: 'Origem: supabase/migrations/20260515120200_create_audit_schema.sql\nRLS habilitado: true\nParticionamento: RANGE (created_at); particoes filhas omitidas.\nOnda 4 P1 — append-only audit log of mutations across services. Partitioned by month to support 5y retention with cheap drop-partition expurgo. Writes via service pool only; reads tenant-scoped via RLS.\nIndice SQL: CREATE INDEX idx_audit_events_actor ON ONLY audit.events USING btree (actor_id, created_at DESC) WHERE (actor_id IS NOT NULL)'
}

Table exports.jobs [headercolor: #52525B] {
  "id" uuid [pk, not null]
  "tenant_id" uuid [not null]
  "requested_by" uuid [not null]
  "entity_type" text [not null]
  "format" text [not null]
  "status" text [not null]
  "metadata" jsonb [not null]
  "created_at" "timestamp with time zone" [not null, default: `now()`]
  "updated_at" "timestamp with time zone" [not null, default: `now()`]
  "deleted_at" "timestamp with time zone"
  Note: 'Origem: supabase/migrations/20260519130000_export_jobs.sql\nRLS habilitado: true\nIndice SQL: CREATE INDEX idx_export_jobs_queue ON exports.jobs USING btree (created_at) WHERE ((status = \'QUEUED\'::text) AND (deleted_at IS NULL))\nIndice SQL: CREATE INDEX idx_export_jobs_requester ON exports.jobs USING btree (tenant_id, requested_by, created_at DESC) WHERE (deleted_at IS NULL)\nIndice SQL: CREATE INDEX idx_export_jobs_tenant_status ON exports.jobs USING btree (tenant_id, status, created_at DESC) WHERE (deleted_at IS NULL)'
}

Ref ai_messages_conversation_id_fkey: ai.messages.("conversation_id") > ai.conversations.("id") [delete: cascade, update: no action, color: #334155]
Ref ai_tool_invocations_conversation_id_fkey: ai.tool_invocations.("conversation_id") > ai.conversations.("id") [delete: cascade, update: no action, color: #334155]
Ref financial_fk_managed_bill_tenant_charge: financial.managed_bills.("tenant_id", "source_charge_id") > financial.charges.("tenant_id", "id") [delete: restrict, update: no action, color: #334155]
Ref financial_fk_managed_bill_tenant_transfer: financial.managed_bills.("tenant_id", "source_transfer_id") > financial.transfers.("tenant_id", "id") [delete: restrict, update: no action, color: #334155]
Ref financial_fk_transfer_deduction_claim_tenant_transfer: financial.transfer_deduction_claims.("tenant_id", "transfer_id") > financial.transfers.("tenant_id", "id") [delete: restrict, update: no action, color: #334155]

