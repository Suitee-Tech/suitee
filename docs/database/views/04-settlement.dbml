Note legenda_layout {
  'Cores dos cabecalhos = dominios. Ref logical_* em cinza claro = vinculo de aplicacao; demais Ref em cinza escuro = FK SQL. json__ = projecao JSONB. 9 tabelas; 17 relacoes neste recorte. Modelo completo: platform.logical.dbml.'
}
