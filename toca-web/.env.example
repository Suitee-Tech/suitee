# ---------------------------------------------------------------------------
# toca-web environment
# Copy to .env (local, ignored by git) and set real values in the platform.
# ---------------------------------------------------------------------------

# Shared Supabase/Postgres connection string. Payload creates its own `payload`
# schema, so it never collides with the product schemas.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/toca

# Payload admin/auth secret. Must be long, random and unique per environment.
PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Canonical origin of this Next/Payload app (admin, media, REST). No trailing
# slash. Public sites use their own Host origin, not this value.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Public storefront host zone. `{marca}.{PUBLIC_SITE_HOST_SUFFIX}`.
# Production: imoveis.suitee.com.br | Local: imoveis.localhost
PUBLIC_SITE_HOST_SUFFIX=imoveis.localhost
# Also exposed to the client/build for the Edge middleware bundle in Docker.
NEXT_PUBLIC_SITE_HOST_SUFFIX=imoveis.localhost

# Optional scheme override for canonical/sitemap URLs. Defaults to http for
# *.localhost and https otherwise.
# PUBLIC_SITE_SCHEME=http

# Validates X-Internal-Key on Payload writes and on POST /api/revalidate.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-key

# Server-to-server toca-sites URL (beacon/lead follow-ups, future integrations).
SITES_INTERNAL_API_URL=http://localhost:8094

# Browser-visible toca-sites base URL. It must be reachable from the tenant
# storefront and allow CORS for https://*.imoveis.suitee.com.br.
NEXT_PUBLIC_SITES_API_URL=http://localhost:8094

# Link "Área do cliente" no header/rodapé do site público.
PORTAL_PUBLIC_URL=http://localhost:3000/portal

# Local/dev: enables Payload schema push so a fresh DB works on first access.
# Production: set false and run `pnpm payload migrate` before starting toca-web.
PAYLOAD_DB_PUSH=true

# Local upload directory when S3 is not configured. Docker uses /app/media.
MEDIA_DIR=./media

# ---------------------------------------------------------------------------
# S3-compatible media storage (production). When these values are present the
# media collection uses @payloadcms/storage-s3; otherwise it writes to
# MEDIA_DIR. Compatible with AWS S3, Cloudflare R2, MinIO and Supabase Storage
# S3 endpoints.
# ---------------------------------------------------------------------------
# S3_BUCKET=toca-web-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=media

# Optional: dedicated revalidation secret. The current contract reuses
# INTERNAL_API_KEY (the Go client only sends X-Internal-Key).
# REVALIDATE_SECRET=
