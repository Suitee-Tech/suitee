# Application Configuration
# Options: development, production
APP_ENV=development
# Options: debug, release, test
APP_MODE=debug
PORT=8089

# Database Configuration
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_core

# Logging Configuration
# Options: debug, info, warn, error
LOG_LEVEL=info
# Options: json, text
LOG_FORMAT=json

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin
CORS_ALLOW_CREDENTIALS=true

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
STORAGE_PROVIDER=supabase

# Address verification (property create/update)
# best_effort: provider outage persists a complete normalized address as unverified
# strict: provider outage rejects the write with HTTP 503
# disabled: no provider I/O; normalize/validate only
ADDRESS_VERIFICATION_MODE=best_effort
ADDRESS_VERIFICATION_PROVIDER=viacep
ADDRESS_VERIFICATION_BASE_URL=https://viacep.com.br
ADDRESS_VERIFICATION_TIMEOUT=2s
ADDRESS_VERIFICATION_CACHE_TTL=24h
ADDRESS_VERIFICATION_CACHE_MAX_ENTRIES=10000

# Internal Auth
INTERNAL_API_KEY=...
