RABBITMQ_DEFAULT_USER=toca_mq_user
RABBITMQ_DEFAULT_PASS=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Database (desenvolvimento local com Supabase CLI)
# Containers do docker compose acessam o host via host.docker.internal.
DATABASE_URI=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable
SUPABASE_DB_URL=${DATABASE_URI}
# Exemplo Supabase remoto/session pooler (5432):
# DATABASE_URI=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# DATABASE_URI_SERVICE — connection used for internal cross-tenant operations that
# must bypass RLS (outbox dispatcher, DLQ replay, invitation lookups).
# • Production Supabase: use porta 5432 (session pooler ou direct) com service_role
#   ou role com BYPASSRLS. Transaction pooler (6543) quebra set_config de sessão.
# • Local dev / vanilla Postgres: may equal DATABASE_URI when APP_MODE is not
#   release. Production/release rejects equal URIs because that would only alias
#   the tenant pool and would not guarantee the required RLS bypass.
DATABASE_URI_SERVICE=${DATABASE_URI}
# REQUIRE_RLS_BACKSTOP — P2/M1: o RLS só é backstop real se o role de
# DATABASE_URI não tiver BYPASSRLS/SUPERUSER. O boot sempre reporta o estado
# (`database.rls_backstop_active`/`database.rls_backstop_disabled`, este último
# como ERROR em release). Com REQUIRE_RLS_BACKSTOP=true o boot FALHA enquanto o
# pool de aplicação bypassar RLS — use quando os caminhos pré-autenticação
# (login, convite por token) já estiverem no pool de serviço.
# Ver supabase/migrations/GUIDELINES.md ("Application role and the RLS backstop").
REQUIRE_RLS_BACKSTOP=
# P2/M11 — limiar (BRL) a partir do qual ajuste de valor em cobrança ou dedução
# de comissão exige a permissão dedicada `finance:approve_adjustment` (default
# R$ 5.000; zero = toda alteração exige aprovação). A permissão é concedida por
# padrão só a `admin`, para que a segunda assinatura seja de outro papel.
FINANCIAL_ADJUSTMENT_APPROVAL_THRESHOLD_BRL=5000
# P2/M14 — cota de OTP POR CONTATO (além do limite de borda por IP). O ramo
# WhatsApp só envia para contato que já é cliente (nada de `create_user` para
# telefone arbitrário). Janela deslizante: N envios por janela, por contato.
OTP_RATE_LIMIT_PER_CONTACT=3
OTP_RATE_LIMIT_WINDOW=15m
# MIGRATION_DATABASE_URI — exclusiva do deploy/migrations. Use uma role DDL
# distinta de DATABASE_URI_SERVICE; ela nunca deve ser injetada nos servicos.
# O gate exige o mesmo host/porta/database da URI de servico e outro usuario.
MIGRATION_DATABASE_URI=postgresql://migration_user:change-me@host.docker.internal:54322/postgres?sslmode=disable
DATABASE_MAX_POOL_SIZE=5
DATABASE_MIN_POOL_SIZE=0

# Verificacao de endereco no toca-core. Em producao, prefira best_effort para
# nao interromper cadastros durante uma indisponibilidade temporaria do ViaCEP.
ADDRESS_VERIFICATION_MODE=best_effort
ADDRESS_VERIFICATION_PROVIDER=viacep
ADDRESS_VERIFICATION_BASE_URL=https://viacep.com.br
ADDRESS_VERIFICATION_TIMEOUT=2s
ADDRESS_VERIFICATION_CACHE_TTL=24h
ADDRESS_VERIFICATION_CACHE_MAX_ENTRIES=10000
# Em dev contra Supabase Session Pooler (porta 5432), o pool_size do projeto é baixo (ex.: ~15 no free).
# Reduza DATABASE_MAX_POOL_SIZE para 1-2 e suba apenas os serviços necessários (ex.: docker compose up postgres rabbitmq toca-portal),
# ou aponte DATABASE_URI para o Postgres local do compose (postgres:5432) para evitar saturação.
REDIS_URI=redis://redis:6379/
RABBITMQ_URI=amqp://toca_mq_user:change-me@rabbitmq:5672/

SUPABASE_URL=http://host.docker.internal:54321
# Browser-facing URL for files and signed links. In beta/prod, use the public
# project URL (for example https://<project-ref>.supabase.co).
SUPABASE_PUBLIC_URL=http://localhost:54321
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=eyJ...local-anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...local-service-role...

# Frontend (Vite) — exposed to the browser. NEVER set VITE_SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=${SUPABASE_PUBLIC_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_API_BASE_URL=http://localhost:8080

STORAGE_PROVIDER=supabase

# Valor somente local. Troque-o se o ambiente puder ser acessado por terceiros.
INTERNAL_API_KEY=local-internal-api-key-change-me

# P1/A15 — TTL da marca de revogação de vínculo (membro removido da empresa).
# O middleware de cada serviço consulta essa marca a cada requisição autenticada;
# o TTL deve cobrir a vida do access token do Supabase (default 1h).
MEMBERSHIP_REVOCATION_TTL=1h

# INTERNAL_SERVICE_KEYS — chaves internas NOMEADAS, opcional (achado A3 da
# revisão de permissões de 2026-09-19). Formato:
#   nome:chave[:tenantA|tenantB],nome2:chave2
# Ex.: toca-financial:9f2c...:t1|t2,toca-deal:7ab1...
#
# Serviço com allowlist de tenants só atende aqueles; serviço sem allowlist (ex.:
# quem atende todos os tenants) segue irrestrito. A INTERNAL_API_KEY continua
# valendo como identidade "legacy" (sem restrição) durante a migração, e cada uso
# dela é registrado em log com event=auth.internal_legacy_key para tornar a
# migração observável. Vazio = modelo antigo (chave única compartilhada).
INTERNAL_SERVICE_KEYS=

AUTH_PORT=8081
CORE_PORT=8082
FINANCIAL_PORT=8083
CRM_PORT=8084
DEAL_PORT=8085
COMM_PORT=8086
OPS_PORT=8087
CALENDAR_PORT=8088
PORTAL_PORT=8089
SIGNATURE_PORT=8093
GATEWAY_PORT=8080
FRONTEND_PORT=3000
GRAFANA_PORT=3001
BUILD_MINIFY=esbuild
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
IMGPROXY_PORT=8091
PROMETHEUS_PORT=9090
LOKI_PORT=3100
MCP_PORT=8090

# Segue a porta do frontend do ambiente: docker build = FRONTEND_PORT (3000);
# Vite standalone (5173) → FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:${FRONTEND_PORT:-3000}
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_GATEWAY_URL=http://localhost:8080
# Base pública dos links gerados por APIs (ex.: .ics da agenda). No local é o
# gateway; em produção, o domínio da API sem `/api/v1` (https://api.example.com).
# O compose de docker-compose.yml falha cedo se ela não existir.
PUBLIC_API_URL=http://localhost:8080
FEED_BASE_URL=http://localhost:8080

# Refresh-token cookie behaviour (toca-auth). Leave empty in dev — the
# defaults pick Lax+insecure on localhost and None+Secure in production.
# In prod, when the frontend (e.g. https://app.example.com) is on a
# different subdomain than the API (https://api.example.com), set:
#   REFRESH_COOKIE_SAMESITE=none
#   REFRESH_COOKIE_DOMAIN=.suitee.com.br
# Otherwise modern browsers won't send the refresh cookie on the
# cross-origin /auth/refresh XHR, breaking session persistence.
REFRESH_COOKIE_SAMESITE=
REFRESH_COOKIE_DOMAIN=

PAYMENT_GATEWAY_API_KEY=

# Abacate Pay v2 webhook security. ABACATEPAY_WEBHOOK_SECRET is the value of the
# ?webhookSecret= query param configured on the webhook in the Abacate Pay
# dashboard; empty disables the query-param check (the X-Webhook-Signature HMAC
# is always verified). ABACATEPAY_WEBHOOK_ALLOWED_IPS optionally restricts
# source IPs (comma-separated IPs/CIDRs); empty disables the IP check.
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_ALLOWED_IPS=

EMAIL_API_KEY=
EMAIL_FROM=update@suitee.com.br
RESEND_API_KEY=
RESEND_FROM_ADDRESS=${EMAIL_FROM}

# Notificações transacionais por e-mail (beta) — kill-switch global e categorias.
# COMM_EMAIL_ENABLED desligado por padrão: ligue apenas quando quiser ativar o canal.
COMM_EMAIL_ENABLED=false

# Régua de follow-up de proposta (§F6, lida pelo toca-deal).
# INTERVAL=0 desliga o sweep; MAX_STAGES=0 desliga a régua por completo.
PROPOSAL_FOLLOWUP_INTERVAL_MINUTES=60
PROPOSAL_FOLLOWUP_STAGE1_DAYS=3
PROPOSAL_FOLLOWUP_GAP_DAYS=7
PROPOSAL_FOLLOWUP_MAX_STAGES=3
PROPOSAL_FOLLOWUP_MAX_AGE_DAYS=30
COMM_EMAIL_LEAD_ASSIGNED=true
COMM_EMAIL_DEAL_UPDATES=true
COMM_EMAIL_PROPOSALS=true
COMM_EMAIL_APPOINTMENTS=true
COMM_EMAIL_RECOMMENDATIONS=true
COMM_EMAIL_CHAT_REMINDERS=true
COMM_EMAIL_COOLDOWN_MINUTES=60
COMM_EMAIL_CHAT_REMINDER_AFTER_MINUTES=30

VITE_IMGPROXY_URL=http://localhost:8091

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me


# AI (Suitee Intelligence)
# Placeholder não funcional que permite subir a stack sem habilitar chamadas
# externas; configure uma chave real apenas ao testar recursos de IA.
DEEPSEEK_API_KEY=local-deepseek-disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PORT=8092
AI_SERVICE_URL=http://toca-ai:8092
MCP_SERVER_URL=http://toca-mcp:8090
OCR_SERVICE_URL=http://toca-ocr:5001
OCR_MEMORY_LIMIT=4g
OCR_CPU_LIMIT=2.0
# Build do toca-ocr: 1 gera a imagem sem baixar os modelos do Docling (~2 GB).
# Use apenas em dev local com o volume docling_models já populado, quando o
# Hugging Face estiver respondendo 429 (rate limit de downloads anônimos).
# SKIP_MODEL_DOWNLOAD=0
# Teto de memória do container do ClamAV (varredura fail-closed de uploads).
# Em hosts de 8 GB, mantenha o padrão (1g): sem teto o clamd vira a primeira
# vítima do OOM killer durante builds pesados e o serviço fica unhealthy.
CLAMAV_MEMORY_LIMIT=1g
AI_MAX_ITERATIONS=5
AI_REQUEST_TIMEOUT_SECONDS=120
AI_LOG_CONTENT=false

# Signature service (Clicksign integration)
SIGNATURE_SERVICE_URL=http://toca-signature:8093
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_WEBHOOK_SECRET=
CLICKSIGN_ENVIRONMENT=sandbox
# How the token is sent in the Authorization header.
# Official v3 docs (docs/signature/signature.md) use the raw token.
#   raw    (default): "Authorization: <token>"
#   bearer          : "Authorization: Bearer <token>" (override for tenants that require it)
CLICKSIGN_AUTH_SCHEME=raw
# Comma-separated allowlist of source IPs Clicksign delivers webhooks from.
# Accepts either exact IPs (203.0.113.10) or CIDR ranges (3.232.199.0/24).
# Empty value disables the IP check (useful in local dev with a tunnel, and
# safe because the HMAC gate remains active and is the actual defense).
# Note: this matches against c.ClientIP() which reads X-Forwarded-For; see
# TRUSTED_PROXIES below if the gateway sits behind a CDN/load balancer.
CLICKSIGN_WEBHOOK_ALLOWED_IPS=203.0.113.10,203.0.113.10
# Comma-separated CIDR list of proxies whose X-Forwarded-For/X-Real-IP headers
# are trusted when resolving the client IP (gateway, toca-signature). Used by
# the edge rate limit, by the admin/internal-key limiter and by the Clicksign
# webhook IP allowlist.
#   set   -> those CIDRs only (the compose stacks default to the container
#            networks: 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16)
#   empty -> FAIL CLOSED: no proxy is trusted, the headers are ignored and
#            c.ClientIP() is the direct TCP peer. Correct when the gateway is
#            exposed directly; wrong behind Traefik/ALB (everyone would share
#            the proxy IP and one client could exhaust the bucket of all).
# Wildcards (0.0.0.0/0, ::/0) are REFUSED in release.
TRUSTED_PROXIES=
# Internal metrics listener of the gateway (Prometheus scrapes gateway:9091).
# The public edge never serves /metrics; keep this port unpublished.
GATEWAY_METRICS_PORT=9091
# The webhook URL you paste into the Clicksign dashboard is derived
# automatically from PUBLIC_GATEWAY_URL above:
#   PUBLIC_GATEWAY_URL + /webhooks/clicksign
# In dev with ngrok: set PUBLIC_GATEWAY_URL=https://abc.ngrok-free.app and
# the toca-signature service will log + serve the full URL on startup
# (also exposed via GET /api/v1/signature/config).
# Override only if there's something in front of the gateway (CDN, custom domain):
WEBHOOK_PUBLIC_URL=
# PDF rendering. With Gotenberg configured, HTML contracts are rendered to
# PDF before being uploaded to Clicksign. Leave empty to require URL/base64/
# raw-PDF content (HTML contracts will fail with ErrHTMLNotSupported).
GOTENBERG_URL=http://gotenberg:3000

# WhatsApp Business (Meta Cloud API) — toca-comm. Empty = canal off,
# NotificationService recusa TypeWhatsApp com erro descritivo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS Zenvia — toca-comm. Empty = canal off, NotificationService recusa
# TypeSMS com erro descritivo. SMS_ZENVIA_FROM é o sender ID/short-code
# aprovado pela Anatel para o tenant (NÃO um número de telefone livre).
SMS_ZENVIA_API_TOKEN=
SMS_ZENVIA_FROM=
SMS_ZENVIA_TIMEOUT_SECONDS=10
SMS_ZENVIA_RETRY_MAX_ATTEMPTS=3
SMS_ZENVIA_RETRY_BASE_DELAY_MS=1000
SMS_ZENVIA_WEBHOOK_SECRET=

# Lead SLA Primeiro Contato — toca-crm. Issue #427. Janela em
# minutos para o corretor fazer o primeiro contato após receber o
# lead atribuído. Quando ultrapassada, o worker dispara
# lead.first_contact_sla_violated e marca o lead. Default 60 (1h).
LEAD_FIRST_CONTACT_SLA_MINUTES=60

# Async exports — toca-crm (#474). Bucket onde o worker faz upload
# dos CSVs/PDFs gerados. URLs pré-assinadas com expiração de 7 dias.
EXPORTS_BUCKET=exports

# Fuso horário dos DIAS CIVIS dos fluxos (lançamentos, relatórios, agendamentos).
# O banco e os contêineres rodam em UTC; sem esta configuração uma baixa às 22h
# em Brasília cairia no dia seguinte (e, na virada do mês, no mês seguinte).
# Padrão: America/Sao_Paulo (Brasília, GMT-3).
APP_TIMEZONE=America/Sao_Paulo

# ─────────────────────────────────────────────────────────────────────────────
# E-mail local (Inbucket do Supabase) — portal, convites e OTP
# ─────────────────────────────────────────────────────────────────────────────
# O compose local usa estes defaults; em produção deixe vazio para usar Resend.
# A caixa visual fica em http://localhost:54324.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_FROM=no-reply@toca.local

# ─────────────────────────────────────────────────────────────────────────────
# Sites das imobiliárias (ADR 0006) — vitrine pública multi-tenant
# ─────────────────────────────────────────────────────────────────────────────
# Sufixo do host comercial. Produção: imoveis.suitee.com.br. Local:
# imoveis.localhost (no macOS resolve sozinho; em Linux mapeie
# `{marca}.imoveis.localhost` em /etc/hosts).
PUBLIC_SITE_HOST_SUFFIX=imoveis.localhost
SITE_PUBLIC_SCHEME=http
# Porta usada nas URLs públicas localmente (o Next fica em WEB_PORT). Em
# produção deixe vazio: https já implica 443.
SITE_PUBLIC_PORT=3002
SITES_PORT=8094
# O toca-web usa 3002: 3000 é o frontend do Toka e 3001 é o Grafana.
WEB_PORT=3002
# Origem aceita pelo CORS das rotas públicas de view/lead. O matcher aceita
# apenas subdomínios do sufixo (nunca um wildcard global).
SITES_PUBLIC_CORS_ORIGIN=http://*.imoveis.localhost
# Segredo de sessão do Payload (>= 32 chars). NUNCA reutilize em produção.
PAYLOAD_SECRET=local-dev-payload-secret-change-me-32
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3002
# Origem (host, sem /api/v1) que o browser do site público usa para view/lead.
# Pode ser o gateway (https://api.example.com) ou o toca-sites direto.
# Portal do cliente (link "Área do cliente" no site). Em produção use o host
# público do portal; local aponta para o Toka.
PORTAL_PUBLIC_URL=http://localhost:3000/portal
NEXT_PUBLIC_SITES_API_URL=http://localhost:8094
# URL interna que o Next usa server-side (rede do compose).
SITES_INTERNAL_API_URL=http://toca-sites:8094
