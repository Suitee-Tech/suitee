APP_ENV=development
APP_MODE=debug
PORT=8087

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_ops

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLIC_URL=${SUPABASE_URL}
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# O bucket toca-documents e privado; operadores recebem URLs assinadas.
STORAGE_PROVIDER=supabase

RABBITMQ_URI=amqp://toca_mq_user:change-me@rabbitmq:5672/
INTERNAL_API_KEY=
