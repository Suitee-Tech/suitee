# Configuration used by scripts/test-stack.sh and the CI integration smoke.
# Values are intentionally local-only and contain no production credentials.
COMPOSE_PROJECT_NAME=suitee-test

APP_ENV=test
APP_MODE=debug

AUTH_PORT=18081
CORE_PORT=18082
FINANCIAL_PORT=18083
CRM_PORT=18084
DEAL_PORT=18085
COMM_PORT=18086
OPS_PORT=18087
CALENDAR_PORT=18088
PORTAL_PORT=18089
SIGNATURE_PORT=18093
GATEWAY_PORT=18080
FRONTEND_PORT=13000
GRAFANA_PORT=13001
BUILD_MINIFY=esbuild
AI_PORT=18092
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25672
JAEGER_UI_PORT=26686
JAEGER_OTLP_GRPC_PORT=14317
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
IMGPROXY_PORT=18091
PROMETHEUS_PORT=19090
LOKI_PORT=13100
MCP_PORT=18090

DATABASE_URI=postgresql://postgres:postgres@postgres:5432/toca_test?sslmode=disable
DATABASE_URI_SERVICE=postgresql://postgres:postgres@postgres:5432/toca_test?sslmode=disable
SUPABASE_DB_URL=postgresql://postgres:postgres@postgres:5432/toca_test?sslmode=disable
DATABASE_MAX_POOL_SIZE=2
DATABASE_MIN_POOL_SIZE=0

REDIS_URI=redis://redis:6379/
RABBITMQ_DEFAULT_USER=toca_test
RABBITMQ_DEFAULT_PASS=toca_test_password
RABBITMQ_URI=amqp://toca_test:toca_test_password@rabbitmq:5672/

MINIO_ROOT_USER=toca_test
MINIO_ROOT_PASSWORD=toca_test_password
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:19000
S3_ACCESS_KEY=toca_test
S3_SECRET_KEY=toca_test_password
S3_REGION=us-east-1
S3_USE_SSL=false

# The stack smoke exercises readiness and routing only. These local placeholders
# keep clients configured without pretending that an external Supabase project
# is part of the isolated Compose environment.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

INTERNAL_API_KEY=test-internal-api-key
DEEPSEEK_API_KEY=test-deepseek-api-key
DEEPSEEK_BASE_URL=https://example.invalid/v1
DEEPSEEK_MODEL=test-model
PAYMENT_GATEWAY_API_KEY=test-payment-gateway-key

FRONTEND_URL=http://127.0.0.1:13000
ALLOWED_ORIGINS=http://127.0.0.1:13000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000
PUBLIC_GATEWAY_URL=http://gateway:8080
# Base pública usada para montar links de e-mail (ex.: .ics da agenda). No stack
# de teste o gateway é publicado em 127.0.0.1:18080.
PUBLIC_API_URL=http://127.0.0.1:18080
FEED_BASE_URL=http://gateway:8080

EMAIL_API_KEY=test-email-api-key
EMAIL_FROM=test@example.invalid

CLICKSIGN_BASE_URL=https://example.invalid
CLICKSIGN_ACCESS_TOKEN=test-clicksign-token
CLICKSIGN_WEBHOOK_SECRET=test-clicksign-webhook-secret
CLICKSIGN_ENVIRONMENT=sandbox
CLICKSIGN_WEBHOOK_ALLOWED_IPS=

ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_ALLOWED_IPS=
