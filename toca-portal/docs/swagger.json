        "/portals/feed/{token}": {
            "get": {
                "description": "Public endpoint crawled by portal bots (ZAP, OLX, VivaReal). Returns cached VRSync XML.",
                "produces": [
                    "text/xml"
                ],
                "tags": [
                    "portals"
                ],
                "summary": "Serve portal XML feed",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Feed token (per-integration)",
                        "name": "token",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "XML feed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Missing feed token",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Feed not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Feed not available yet",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
