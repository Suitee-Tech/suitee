APP_ENV=development
APP_MODE=debug
PORT=8085

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_deal

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json

RABBITMQ_URI=amqp://toca_mq_user:change-me@rabbitmq:5672/
INTERNAL_API_KEY=
AUTH_SERVICE_URL=http://localhost:8081

# Tenant approval policy (toca-auth cache + explicit availability fallback)
APPROVAL_POLICY_CACHE_TTL_SECONDS=300
APPROVAL_POLICY_STALE_TTL_SECONDS=3600
APPROVAL_POLICY_FETCH_TIMEOUT_MS=800
# Used only when toca-auth has no fresh/stale policy available. <= 0 disables.
TOCA_DEAL_APPROVAL_THRESHOLD_BRL=500000
SIGNATURE_SERVICE_URL=http://localhost:8093
