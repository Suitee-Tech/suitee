OCR_CPU_LIMIT=2.0
AI_MAX_ITERATIONS=5
AI_REQUEST_TIMEOUT_SECONDS=120
AI_LOG_CONTENT=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
