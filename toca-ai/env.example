PORT=8092
DATABASE_URI=
DATABASE_URI_SERVICE=
SUPABASE_JWKS_URL=
INTERNAL_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
MCP_SERVER_URL=http://toca-mcp:8090
