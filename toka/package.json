{
  "name": "suitee-frontend",
  "description": "Frontend (React + Vite) for Suitee Platform, a B2B SaaS for real estate management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Suitee",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "build": "vite build",
    "build:ci": "vite build && pnpm bundle:check && node scripts/check-bundle-secrets.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "check": "pnpm lint && pnpm test && pnpm build:ci",
    "dev": "vite",
    "lint": "pnpm lint:types && pnpm lint:boundaries && pnpm lint:quality && pnpm lint:design && pnpm lint:text-floor && pnpm lint:copy && pnpm test:tooling",
    "lint:types": "tsc --build --noEmit",
    "lint:boundaries": "node scripts/check-feature-boundaries.mjs --all",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/check-e2e-classification.mjs && CI=1 playwright test --config=playwright.ci.config.ts",
    "lint:quality": "node scripts/check-code-quality.mjs",
    "lint:design": "node scripts/check-design-system.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test --config=playwright.ci.config.ts settings-consistency",
    "lint:copy": "node scripts/check-copy.mjs",
    "lint:text-floor": "node scripts/check-text-floor.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "^5.9.2",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@playwright/test": "^1.64.1",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-aspect-ratio": "1.2.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-menubar": "1.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@superdoc-dev/react": "^1.16.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "docxtemplater": "^3.71.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "1.61.0",
    "motion": "12.43.0",
    "next-themes": "0.4.6",
    "pdfjs-dist": "5.4.296",
    "pizzip": "^3.3.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.7",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.83.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "4.14.8",
    "react-responsive-masonry": "2.9.0",
    "react-router": "8.5.0",
    "react-slick": "0.31.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "superdoc": "^2.26.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/parser": "7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.12"
  }
}
