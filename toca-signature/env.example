APP_ENV=development
APP_MODE=debug
PORT=8093

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_signature

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json

RABBITMQ_URI=amqp://toca_mq_user:change-me@rabbitmq:5672/
INTERNAL_API_KEY=

CORE_SERVICE_URL=http://toca-core:8082
DEAL_SERVICE_URL=http://toca-deal:8085

# Public gateway URL — used to derive the Clicksign webhook URL automatically:
#   webhook = PUBLIC_GATEWAY_URL + /webhooks/clicksign
# In dev with ngrok: set this to the ngrok https URL.
PUBLIC_GATEWAY_URL=http://localhost:8080
# Optional override (only when there's a CDN/proxy in front of the gateway).
WEBHOOK_PUBLIC_URL=

# Clicksign
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_WEBHOOK_SECRET=
CLICKSIGN_ENVIRONMENT=sandbox
# How the token is sent in the Authorization header.
# Official v3 docs (docs/signature/signature.md) use the raw token.
#   raw    (default): "Authorization: <token>"
#   bearer          : "Authorization: Bearer <token>" (override for tenants that require it)
CLICKSIGN_AUTH_SCHEME=raw
# Comma-separated allowlist; empty disables IP check.
CLICKSIGN_WEBHOOK_ALLOWED_IPS=203.0.113.10,203.0.113.10
# Gotenberg HTML→PDF renderer. Leave empty to disable HTML support.
GOTENBERG_URL=http://gotenberg:3000
