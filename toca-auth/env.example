# Application Configuration
# Options: development, production
APP_ENV=development
# Options: debug, release, test
APP_MODE=debug
PORT=8090

# Database Configuration
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/toca?sslmode=disable
DATABASE_URI_SERVICE=${DATABASE_URI}
DATABASE_NAME=toca_auth

# Logging Configuration
# Options: debug, info, warn, error
LOG_LEVEL=info
# Options: json, text
LOG_FORMAT=json

# CORS Configuration
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin
CORS_ALLOW_CREDENTIALS=true

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
STORAGE_PROVIDER=supabase

# Internal Auth
INTERNAL_API_KEY=...

# Redis Configuration (session management + token blacklist)
REDIS_URI=redis://localhost:6379

# Password Security
BCRYPT_COST=12

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
